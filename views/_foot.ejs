</div><footer class="foot"><%= brand %></footer><script>document.addEventListener('click',function(e){var b=e.target.closest('[data-copy]');if(!b)return;var v=b.getAttribute('data-copy');var o=b.textContent;var done=function(){b.textContent='Copied ✓';setTimeout(function(){b.textContent=o},1500)};if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(v).then(done)}else{var t=document.createElement('textarea');t.value=v;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove();done()}});</script></body></html>
